# PostgreSQL externo. No desactivar verificación TLS en producción.
DATABASE_URL=postgresql://topchess:change-me@localhost:5432/topchess
APP_URL=http://127.0.0.1:3000
# Lichess admite clientes públicos sin client_secret. Usar un identificador propio del dominio.
LICHESS_CLIENT_ID=topchess-global
# Clave de 32 bytes en hexadecimal para cifrar el intento OAuth (NO es un token de Lichess).
OAUTH_COOKIE_SECRET=
# Sin base de datos conectada no se publican perfiles ni grupos.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SECRET=
# Stripe: clave restringida y firma de webhook solo en el servidor.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Tipo fiscal inclusivo validado para la actividad. No se presupone un 21 %.
STRIPE_TAX_RATE_ID=
# Solo activar tras validar calendario, fiscalidad, contrato y pruebas de sandbox.
BILLING_ENABLED=false
# Correo transaccional: endpoint HTTPS propio compatible con {to,subject,text}.
MAIL_API_URL=
MAIL_API_TOKEN=
MAIL_FROM=
# S3 compatible PRIVADO. IAM mínimo; bloquear acceso público del bucket.
S3_REGION=eu-west-1
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Lista de dominios autorizados para enlaces de videoclase (separados por coma).
VIDEO_ALLOWED_HOSTS=meet.google.com,meet.jit.si,zoom.us,*.zoom.us
# Trabajo programado protegido. Generar un secreto independiente de 32 bytes.
CRON_SECRET=
# Debe permanecer false hasta revisión profesional de contratos y datos del titular.
LEGAL_READY=false
