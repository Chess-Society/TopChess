{
  "name": "topchess-global",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "admin:create": "tsx scripts/promote-admin.ts",
    "format": "prettier --write src scripts tests docs README.md *.ts *.mjs *.json",
    "build:cloudflare": "opennextjs-cloudflare build",
    "cloudflare:deploy": "opennextjs-cloudflare deploy",
    "cloudflare:login": "wrangler login"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1158.0",
    "@opennextjs/cloudflare": "1.20.13",
    "@radix-ui/react-select": "2.4.1",
    "date-fns-tz": "3.2.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.63.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stripe": "^23.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "wrangler": "4.154.0"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "^10.5.0"
    }
  }
}
